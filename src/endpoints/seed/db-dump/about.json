      "offsetX": 0,
      "blockName": "Fresh Eggs Image",
      "blockType": "mediaBlock"
    },
    {
      "id": "6976c67af9030500047d2a2d",
      "blockName": "Our Beginning Part 2",
      "columns": [
        {
          "id": "6976c67af9030500047d2a2c",
          "size": "full",
          "contentType": "text",
          "media": null,
          "mediaWidth": 100,
          "mediaPosition": "above",
          "richText": {
            "root": {
              "type": "root",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "type": "paragraph",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "To meet market demand and raise the standard of Taiwan's egg industry, Co-Founder & Chairman Ku Rong-Hai and Co-Founder Ku Hong-Lin established Chinyi Egg Products on ",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    },
                    {
                      "mode": "normal",
                      "text": "October 25, 1981",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 1,
                      "version": 1
                    },
                    {
                      "mode": "normal",
                      "text": " as Taiwan's first specialized liquid egg company.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr",
                  "textFormat": 0
                }
              ],
              "direction": "ltr"
            }
          },
          "enableLink": null,
          "link": {
            "type": "reference",
            "newTab": null,
            "url": null,
            "label": null,
            "appearance": "default"
          }
        }
      ],
      "blockType": "content"
    },
    {
      "id": "6976c67af9030500047d2a2f",
      "blockName": "Remarkable Achievement Part 1",
      "columns": [
        {
          "id": "6976c67af9030500047d2a2e",
          "size": "full",
          "contentType": "text",
          "media": null,
          "mediaWidth": 100,
          "mediaPosition": "above",
          "richText": {
            "root": {
              "type": "root",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "tag": "h3",
                  "type": "heading",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Remarkable Achievement",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr"
                },
                {
                  "type": "paragraph",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "With the support of many customers and consumers, Chinyi has grown to be outstanding in its development.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 2,
                      "version": 1
                    }
                  ],
                  "direction": "ltr",
                  "textFormat": 0
                },
                {
                  "type": "paragraph",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Today, Chinyi is Taiwan's egg products company with the largest production capacity and the broadest service coverage. With over 80 company vehicles, delivery spans from Yilan in the north to Pingtung in the south. Our professional logistics capability leads the industry. We hold a high market share in Taiwan's liquid egg market. Many large-scale food manufacturers, bakery businesses, five-star hotels, airline catering services, chain restaurants, and institutional meal providers are among our clients.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr",
                  "textFormat": 0
                }
              ],
              "direction": "ltr"
            }
          },
          "enableLink": null,
          "link": {
            "type": "reference",
            "newTab": null,
            "url": null,
            "label": null,
            "appearance": "default"
          }
        }
      ],
      "blockType": "content"
    },
