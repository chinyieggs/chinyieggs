    {
      "id": "6976c67af9030500047d2a3b",
      "blockName": "Dedication & Compassion Part 2",
      "columns": [
        {
          "id": "6976c67af9030500047d2a3a",
          "size": "full",
          "contentType": "text",
          "media": null,
          "mediaWidth": 100,
          "mediaPosition": "above",
          "richText": {
            "root": {
              "type": "root",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "type": "paragraph",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Beyond egg processing and transportation, Chinyi has expanded into egg-laying chicken farming, based in the pristine Chiayi region. We have built several large modern chicken farms under high standards to produce premium Chinyi eggs.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr",
                  "textFormat": 0
                }
              ],
              "direction": "ltr"
            }
          },
          "enableLink": null,
          "link": {
            "type": "reference",
            "newTab": null,
            "url": null,
            "label": null,
            "appearance": "default"
          }
        }
      ],
      "blockType": "content"
    },
    {
      "id": "6976c67af9030500047d2a3c",
      "variant": "info",
      "content": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Chinyi has become a vertically integrated enterprise",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 1,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": "—from chicken farming, to egg product processing, to final logistics and delivery—adhering to our company belief ",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": "\"Cherishing Everyone. Treasuring Taiwan\"",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 1,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": " and following the development direction of ",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": "\"Most Natural. Most Technological\"",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 1,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": " to provide the people of Taiwan with even higher-quality egg products. We press on toward the future.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": "ltr",
              "textFormat": 0
            }
          ],
          "direction": "ltr"
        }
      },
      "author": null,
      "blockName": "Vertical Integration",
      "blockType": "highlightBox"
