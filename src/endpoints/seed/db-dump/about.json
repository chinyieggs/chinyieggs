    {
      "id": "6976c67af9030500047d2a32",
      "blockName": "Remarkable Achievement Part 2",
      "columns": [
        {
          "id": "6976c67af9030500047d2a31",
          "size": "full",
          "contentType": "text",
          "media": null,
          "mediaWidth": 100,
          "mediaPosition": "above",
          "richText": {
            "root": {
              "type": "root",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "type": "paragraph",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Our production facilities are located in Chiayi, close to the main egg-producing regions (most egg farms in Taiwan are south of Changhua), enabling \"local production, fresh delivery,\" ensuring high product quality.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr",
                  "textFormat": 0
                }
              ],
              "direction": "ltr"
            }
          },
