    {
      "id": "6976c683f9030500047d2a5d",
      "blockName": "Introduction",
      "columns": [
        {
          "id": "6976c683f9030500047d2a5c",
          "size": "full",
          "contentType": "text",
          "media": null,
          "mediaWidth": 100,
          "mediaPosition": "above",
          "richText": {
            "root": {
              "type": "root",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "type": "paragraph",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Eggs are complex organic products, prone to contamination by pathogens like Salmonella or E. coli, which can cause quality degradation. In addition, drug residues in eggs are a serious concern for consumers. Because many poultry farms lack the technology or capacity to enforce strict controls at the source, the responsibility of quality control naturally falls to the egg-product companies.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr",
                  "textFormat": 0
                }
              ],
              "direction": "ltr"
            }
          },
          "enableLink": null,
          "link": {
            "type": "reference",
            "newTab": null,
            "url": null,
            "label": null,
            "appearance": "default"
          }
        }
      ],
      "blockType": "content"
    },
    {
      "id": "6976c683f9030500047d2a5e",
      "variant": "info",
      "content": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Chinyi upholds the corporate belief of ",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": "\"Cherishing Everyone. Treasuring Taiwan.\"",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 1,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": " We are always mindful of consumer safety and health. We lead the industry with a state-of-the-art quality assurance laboratory in our factory. Using operating standards in line with international requirements, we strictly oversee the production of every batch of egg products.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": "ltr",
              "textFormat": 0
            }
          ],
          "direction": "ltr"
        }
      },
      "author": null,
      "blockName": "Quality Philosophy",
      "blockType": "highlightBox"
    },
