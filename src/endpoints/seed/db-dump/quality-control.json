                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Because egg products are closely linked to consumers' daily health, Chinyi attaches special importance to and demands rigor in quality assurance — implemented through daily routines:",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
