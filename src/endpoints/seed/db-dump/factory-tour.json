    {
      "id": "697e1a97a6eca85bd738dfdb",
      "blockName": "Pasteurized Production",
      "columns": [
        {
          "id": "697e1a97a6eca85bd738dfda",
          "size": "full",
          "contentType": "text",
          "media": null,
          "mediaWidth": 100,
          "mediaPosition": "above",
          "richText": {
            "root": {
              "type": "root",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "tag": "h3",
                  "type": "heading",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Pasteurized Liquid Egg Production",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr"
                },
                {
                  "type": "paragraph",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "We've introduced Taiwan's newest and largest continuous sterilization equipment from Denmark, combining \"Fresh House\" packaging and automatic pouch filling technologies. From washing, cracking eggs, sterilization, to packaging, the entire process is automated—bringing Taiwanese liquid egg standards into the league of the world's most advanced nations.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr",
                  "textFormat": 0
                }
              ],
              "direction": "ltr"
            }
          },
          "enableLink": null,
          "link": {
            "type": "reference",
            "newTab": null,
            "url": null,
            "label": null,
            "appearance": "default"
          }
        }
      ],
      "blockType": "content"
    },
    {
      "id": "697e1a97a6eca85bd738dfdc",
      "media": 32,
      "imageUrl": "",
      "alt": "Modern food production line",
      "width": 100,
      "offsetX": 0,
      "blockName": "Production Line Image",
      "blockType": "mediaBlock"
    },
    {
      "id": "697e1a97a6eca85bd738dfdd",
      "variant": "info",
      "content": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Using internationally recognized Pasteur low-temperature sterilization. Through a plate heat exchanger (preheat → heating for sterilization → cooling → chilling), we eliminate Salmonella, E. coli, and various harmful microbes and spoilage bacteria. The entire sterilization process is conducted through elevated, sealed piping systems—thoroughly isolating the process from external contamination.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": "ltr",
              "textFormat": 0
            }
          ],
          "direction": "ltr"
        }
      },
      "author": null,
      "blockName": "Pasteurization Process",
      "blockType": "highlightBox"
    },
