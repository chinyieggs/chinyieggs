    },
    {
      "id": "697e1a97a6eca85bd738dfd6",
      "blockName": "Chinyi Difference",
      "columns": [
        {
          "id": "697e1a97a6eca85bd738dfd5",
          "size": "full",
          "contentType": "text",
          "media": null,
          "mediaWidth": 100,
          "mediaPosition": "above",
          "richText": {
            "root": {
              "type": "root",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "tag": "h3",
                  "type": "heading",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "The Chinyi Difference",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr"
                },
                {
                  "type": "paragraph",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Chinyi has specialized in Taiwan's egg industry for over 40 years. We insist on moving forward with the times, learning from advanced countries in Europe and the U.S., and continuously advancing Taiwan's egg-product standards.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr",
                  "textFormat": 0
                }
              ],
              "direction": "ltr"
            }
          },
          "enableLink": null,
          "link": {
            "type": "reference",
            "newTab": null,
            "url": null,
            "label": null,
            "appearance": "default"
          }
        }
      ],
      "blockType": "content"
    },
    {
      "id": "697e1a97a6eca85bd738dfd7",
      "variant": "info",
      "content": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Our factory is highly automated. The core manufacturing area is a cleanroom meeting ",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": "100,000-class specifications",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 1,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": ". Entrances and exits for personnel are separated. Air is independently circulated. Pipelines are elevated overhead. Visitors entering Chinyi's factory for the first time often feel as though they've stepped into a wafer fab in a science park.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": "ltr",
              "textFormat": 0
            }
          ],
          "direction": "ltr"
        }
      },
      "author": null,
      "blockName": "Cleanroom",
      "blockType": "highlightBox"
    },
    {
      "id": "697e1a97a6eca85bd738dfd9",
      "blockName": "Open Doors",
      "columns": [
        {
          "id": "697e1a97a6eca85bd738dfd8",
          "size": "full",
          "contentType": "text",
          "media": null,
          "mediaWidth": 100,
          "mediaPosition": "above",
          "richText": {
            "root": {
              "type": "root",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "type": "paragraph",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Built on integrity, Chinyi opens its doors wide: all production lines are visible to the public. From home, you can feel like you're on a guided tour—witness Chinyi's professionalism firsthand.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": "ltr",
                  "textFormat": 0
                }
              ],
              "direction": "ltr"
            }
          },
          "enableLink": null,
          "link": {
            "type": "reference",
            "newTab": null,
            "url": null,
            "label": null,
            "appearance": "default"
          }
        }
      ],
      "blockType": "content"
